# Garmin Connect credentials for the PARENT account (the child does not log in
# independently - Garmin child/family accounts are restricted from direct SSO,
# see garmin2intervals/client.py). The son's activities are reached through the
# parent's session via Garmin's family/connections view.
GARMIN_EMAIL=parent@example.com
GARMIN_PASSWORD=example_password

# Where garminconnect caches OAuth tokens after the first (possibly MFA) login,
# so subsequent runs don't need to re-authenticate. Directory is gitignored.
GARMINTOKENS=.garmin_tokens

# Garmin's internal id (or display name) for the son's family/child profile,
# once identified - see README's "Child account access" section.
GARMIN_CHILD_USER_ID=

# intervals.icu - create an API key at https://intervals.icu/settings > Developer Settings
INTERVALS_API_KEY=example_intervals_api_key
INTERVALS_ATHLETE_ID=i000000
